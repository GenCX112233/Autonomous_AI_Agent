# Copy this file to .env and fill in what you need.

# Which LLM powers every agent in the system: anthropic | openai | mock
LLM_PROVIDER=mock

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- OpenAI (GPT) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# --- Agent loop ---
MAX_AGENT_TOOL_TURNS=6

# --- Sample CRM app (Use Case 2) ---
CRM_BASE_URL=http://127.0.0.1:8001
# 127.0.0.1 works when the UI and CRM run in the same WSL instance.
# A current WSL IP also works; the CRM auto-starter will bind all interfaces.
AUTO_START_CRM=true

GENESYS_SEED=42

# --- Use Case 1 human-in-the-loop ---
# Set to true to skip the interactive approval prompt (useful for CI/demos)
AUTO_APPROVE=false
